{
  "name": "@sarpbc/utils",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./client-address": {
      "types": "./src/client-address.ts",
      "require": "./dist/client-address.js",
      "default": "./src/client-address.ts"
    },
    "./entity-path": {
      "types": "./src/entity-path.ts",
      "require": "./dist/entity-path.js",
      "default": "./src/entity-path.ts"
    },
    "./source-host": {
      "types": "./src/source-host.ts",
      "require": "./dist/source-host.js",
      "default": "./src/source-host.ts"
    },
    "./stream-score": {
      "types": "./src/stream-score.ts",
      "require": "./dist/stream-score.js",
      "default": "./src/stream-score.ts"
    },
    "./text": {
      "types": "./src/text.ts",
      "require": "./dist/text.js",
      "default": "./src/text.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @sarpbc/types build && tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\""
  },
  "dependencies": {
    "@sarpbc/types": "workspace:*",
    "slugify": "^1.6.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
