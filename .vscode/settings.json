{
    "files.associations": {
      "*.css": "tailwindcss"
    },
    "editor.quickSuggestions": {
      "strings": "on"
    },
    "[javascript]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[typescript]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[vue]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[*]": {
      "editor.defaultFormatter": "oxc.oxc-vscode"
    }
  }