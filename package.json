{
  "name": "sarpbc",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sarpbc/sarpbc.git"
  },
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test:git-names": "node --test scripts/check-git-names.test.ts",
    "test:checks": "node --test scripts/check-i18n-parity.test.ts scripts/check-package-imports.test.ts",
    "check:i18n": "node scripts/check-i18n-parity.ts",
    "check:packages": "node scripts/check-package-imports.ts",
    "check:node": "node scripts/check-node-version.ts",
    "dev": "turbo run dev",
    "dev:back": "turbo run dev --filter=back...",
    "dev:front": "turbo run dev --filter=front",
    "dev:admin": "turbo run dev --filter=admin",
    "build": "turbo run build",
    "lint": "oxlint --deny-warnings scripts && turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "typecheck": "pnpm typecheck:scripts && turbo run typecheck"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.91.0",
    "@types/node": "catalog:",
    "lefthook": "^2.2.2",
    "only-allow": "^1.2.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2007",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.15.0"
}
