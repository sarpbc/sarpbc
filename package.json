{
  "name": "sarpbc",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm --parallel --filter ./apps/back --filter ./apps/front dev",
    "dev:back": "pnpm --filter back dev",
    "dev:front": "pnpm --filter front dev",
    "build": "pnpm -r --filter ./apps/* build",
    "start": "pnpm --filter back start",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check"
  },
  "devDependencies": {
    "lefthook": "^2.1.9",
    "only-allow": "^1.2.2",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0"
  },
  "packageManager": "pnpm@11.8.0"
}
