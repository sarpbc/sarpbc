{
  "name": "sarpbc",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sarpbc/sarpbc.git"
  },
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test:git-names": "node --test scripts/check-git-names.test.mjs",
    "test:checks": "node --test scripts/check-i18n-parity.test.mjs scripts/check-package-imports.test.mjs",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "check:packages": "node scripts/check-package-imports.mjs",
    "check:node": "node scripts/check-node-version.mjs",
    "dev": "turbo run dev",
    "dev:back": "turbo run dev --filter=back",
    "dev:front": "turbo run dev --filter=front",
    "dev:admin": "turbo run dev --filter=admin",
    "build": "turbo run build",
    "lint": "oxlint --deny-warnings scripts && turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "lefthook": "^2.2.2",
    "only-allow": "^1.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@12.15.0"
}
