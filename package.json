{
  "name": "sarpbc",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sarpbc/sarpbc.git"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test:git-names": "node --test scripts/check-git-names.test.mjs",
    "dev": "turbo run dev",
    "dev:back": "turbo run dev --filter=back",
    "dev:front": "turbo run dev --filter=front",
    "dev:admin": "turbo run dev --filter=admin",
    "build": "turbo run build",
    "start": "pnpm --filter back start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "fmt": "turbo run fmt",
    "fmt:check": "turbo run fmt:check",
    "test:back": "turbo run test --filter=back"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "lefthook": "^2.2.2",
    "only-allow": "^1.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@12.15.0"
}
