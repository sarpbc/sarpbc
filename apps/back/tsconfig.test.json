{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2025",
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
