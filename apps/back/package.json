{
  "name": "back",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "nest build",
    "dev": "pnpm run start:dev",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "node scripts/check-architecture.mjs && oxlint .",
    "lint:fix": "oxlint . --fix && node scripts/check-architecture.mjs",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check",
    "mikro:migrate": "mikro-orm migration:up",
    "mikro:migrate:prod": "mikro-orm migration:up --config ./dist/mikro-orm.config.js",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "pnpm run build && vitest run --coverage",
    "test:e2e": "vitest run --project e2e",
    "typecheck": "tsc -p tsconfig.build.json --noEmit --incremental false",
    "typecheck:tests": "tsc -p tsconfig.test.json --incremental false",
    "test:architecture": "node --test scripts/check-architecture.test.mjs && node scripts/check-architecture.mjs",
    "test:contracts": "node scripts/check-http-contract.mjs",
    "test:integration": "pnpm run build && vitest run --project integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@mikro-orm/cli": "catalog:",
    "@mikro-orm/core": "catalog:",
    "@mikro-orm/decorators": "catalog:",
    "@mikro-orm/entity-generator": "catalog:",
    "@mikro-orm/migrations": "catalog:",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "catalog:",
    "@mikro-orm/seeder": "catalog:",
    "@mikro-orm/sql-highlighter": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@sarpbc/types": "workspace:*",
    "@sarpbc/utils": "workspace:*",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "evlog": "catalog:",
    "fastify": "5.12.7",
    "googleapis": "^187.0.0",
    "ioredis": "^6.0.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "posthog-node": "^5.56.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "slugify": "^1.6.9",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "catalog:",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "catalog:",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/mikro-orm.config.ts"
    ],
    "tsLoader": "swc"
  }
}
