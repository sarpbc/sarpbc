{
  "name": "back",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter @sarpbc/utils... run build",
    "build": "nest build",
    "dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "node scripts/check-architecture.mjs && oxlint --deny-warnings .",
    "lint:fix": "oxlint . --fix && node scripts/check-architecture.mjs",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check",
    "premikro:migrate": "pnpm --filter @sarpbc/utils... run build",
    "mikro:migrate": "mikro-orm migration:up",
    "mikro:migrate:prod": "node dist/migrate",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "pnpm run build && vitest run --coverage",
    "test:e2e": "vitest run --project e2e",
    "typecheck": "tsc -p tsconfig.build.json --noEmit --incremental false",
    "typecheck:tests": "tsc -p tsconfig.test.json --incremental false",
    "test:architecture": "node --test scripts/check-architecture.test.mjs && node scripts/check-architecture.mjs",
    "test:migrations": "node --test scripts/check-migrations.test.mjs && node scripts/check-migrations.mjs",
    "test:contracts": "node scripts/check-http-contract.mjs",
    "test:integration": "pnpm run build && vitest run --project integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@googleapis/oauth2": "^10.0.1",
    "@mikro-orm/core": "catalog:",
    "@mikro-orm/decorators": "catalog:",
    "@mikro-orm/migrations": "catalog:",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "catalog:",
    "@mikro-orm/sql-highlighter": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "catalog:",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@sarpbc/types": "workspace:*",
    "@sarpbc/utils": "workspace:*",
    "axios": "^1.21.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.8",
    "evlog": "catalog:",
    "fastify": "catalog:",
    "ioredis": "^6.0.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "posthog-node": "^5.59.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mikro-orm/cli": "catalog:",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "catalog:",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.18",
    "@types/bcrypt": "^6.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "supertest": "^7.3.1",
    "typescript": "catalog:",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/mikro-orm.config.ts"
    ],
    "tsLoader": "swc"
  }
}
