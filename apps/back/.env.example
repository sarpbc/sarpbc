DB_HOST="postgresdb"
DB_PORT=5433
DB_USER="sarpbc"
DB_PASSWORD="password"
DB_NAME="sarpbc"

# Local/dev only — use a long random secret in production (Dokploy / Docker secrets).
JWT_KEY="my-super-secret-key"

REDIS_HOST="redis"
REDIS_PASSWORD=

PORT=4001

# Shared with the front's NUXT_API_INTERNAL_TOKEN. When set, requests that send
# this value in x-sarpbc-internal are limited per visitor (x-sarpbc-client)
# instead of by the calling container. Leave unset locally.
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=

FRONT_URL=http://localhost:4000
INDEXNOW_KEY=
ADMIN_URL=http://localhost:4002

# Bring your own key. PandaScore data/assets are subject to their ToS, not Apache-2.0.
# Never commit real tokens. Dev placeholders below are not for production.
PANDASCORE_API_TOKEN=""
PANDASCORE_SYNC_ON_BOOT=false

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4001/auth/google/callback"

CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_HASH=""

R2_ACCOUNT_ID=""
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
