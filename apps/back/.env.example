# Host workflow: matches docker-compose.local.yml (Postgres on 5433, Redis on 6380).
# Boot fails without DB_PASSWORD, JWT_KEY, FRONT_URL, ADMIN_URL, PANDASCORE_API_TOKEN and GOOGLE_*. Image uploads fail with a clear error until CLOUDFLARE_* and R2_* are set.
DB_HOST="localhost"
DB_PORT=5433
DB_USER="sarpbc"
DB_PASSWORD="password"
DB_NAME="sarpbc"

# Local/dev only — use a long random secret in production (Docker secrets).
JWT_KEY="my-super-secret-key"

REDIS_HOST="localhost"
REDIS_PORT=6380
REDIS_PASSWORD=

PORT=4001

POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=

INTERNAL_API_TOKEN=

FRONT_URL=http://localhost:4000
INDEXNOW_KEY=
ADMIN_URL=http://localhost:4002

# Bring your own key. PandaScore data/assets are subject to their ToS, not Apache-2.0.
# Never commit real tokens. Dev placeholders below are not for production.
PANDASCORE_API_TOKEN=""
PANDASCORE_SYNC_ON_BOOT=false

# Bring your own key from https://ballchasing.com/upload. Staff stats imports stay off without it.
# Ballchasing data is subject to its own terms, not Apache-2.0. Never commit a real key.
BALLCHASING_API_KEY=""

TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4001/auth/google/callback"

CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_HASH=""

R2_ACCOUNT_ID=""
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
