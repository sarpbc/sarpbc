{
  "name": "front",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 4000",
    "postinstall": "nuxt prepare",
    "lint": "node scripts/generate-oxlint-globals.ts && oxlint --deny-warnings -c .oxlintrc.generated.json . && node scripts/lint-hub-row-heights.ts",
