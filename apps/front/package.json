    "@nuxt/fonts": "^1.2.0",
    "@nuxt/icon": "^2.6.3",
    "@nuxt/image": "^2.2.1",
    "@nuxtjs/color-mode": "^4.1.0",
    "@nuxtjs/i18n": "catalog:",
    "@nuxtjs/sitemap": "^9.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sarpbc/composables": "workspace:*",
    "@sarpbc/design": "workspace:*",
    "@sarpbc/types": "workspace:*",
    "@sarpbc/ui": "workspace:*",
    "@sarpbc/utils": "workspace:*",
