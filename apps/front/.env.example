NUXT_PUBLIC_API_BASE=http://localhost:4001
# Server-side fetches (SSR and Nitro) use this instead of NUXT_PUBLIC_API_BASE.
# Leave unset for local dev. On Dokploy, set the back service DNS name on
# dokploy-network and the API port (4001), for example:
# NUXT_API_BASE_SERVER=http://sarpbcorg-back-lc37mk:4001
NUXT_API_BASE_SERVER=
# Same value as the API INTERNAL_API_TOKEN. Sent only by the Nuxt server to that
# private origin so those calls are not rate limited. Leave unset locally.
# Generate with: openssl rand -hex 32
NUXT_API_INTERNAL_TOKEN=
NUXT_PUBLIC_ADMIN_URL=http://localhost:4002
NITRO_PORT=4000
NUXT_INDEXNOW_KEY=
NUXT_PUBLIC_GTAG_ID=""
NUXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NUXT_PUBLIC_POSTHOG_HOST=https://t.sarpbc.org
NUXT_PUBLIC_R2_PUBLIC_BASE_URL=
